{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash ./copilot-on-toast.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10,
        "env": { "COPILOT_HOOK_EVENT": "sessionStart" }
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash ./copilot-on-toast.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10,
        "env": { "COPILOT_HOOK_EVENT": "sessionEnd" }
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash ./copilot-on-toast.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10,
        "env": { "COPILOT_HOOK_EVENT": "agentStop" }
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "bash ./copilot-on-toast.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10,
        "env": { "COPILOT_HOOK_EVENT": "errorOccurred" }
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "bash ./copilot-on-toast.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10,
        "env": { "COPILOT_HOOK_EVENT": "userPromptSubmitted" }
      }
    ],
    "permissionRequest": [
      {
        "type": "command",
        "bash": "bash ./copilot-on-toast.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10,
        "env": { "COPILOT_HOOK_EVENT": "permissionRequest" }
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "bash ./copilot-on-toast.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 10,
        "env": { "COPILOT_HOOK_EVENT": "postToolUseFailure" }
      }
    ]
  }
}
